{
  "expo": {
    "name": "Noomori",
    "slug": "noomori",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/noomori-icon.png",
    "scheme": "noomori",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/noomori-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/noomori-adaptive-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/noomori-adaptive-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.noomori.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDF8",
          "image": "./assets/images/noomori-icon.png",
          "imageWidth": 144,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#147D78",
          "defaultChannel": "household-recipe-activity"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17646bf7-ef3c-4039-b9e0-677adbaf453c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/17646bf7-ef3c-4039-b9e0-677adbaf453c"
    }
  }
}
